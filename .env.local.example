NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — server-only. Powers /admin reads (bypasses RLS).
# Find it in Supabase Dashboard -> Project Settings -> API.
# NEVER expose this client-side. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Passcode for the /admin panel. Pick something long and random.
# Used as a single shared secret until full auth ships.
ADMIN_PASSCODE=change-me-to-something-long

# Your WhatsApp number in international format, no + or spaces.
# Example: India 98765 43210 -> 919876543210
NEXT_PUBLIC_ADMIN_WHATSAPP=your-whatsapp-number

# Public canonical URL of the deployed site, no trailing slash.
# Used for OG/Twitter share previews, sitemap.xml, and robots.txt.
# Local dev: leave empty (falls back to http://localhost:3000).
# Vercel: set in Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
